inventory = NodePath("../../Inventory")

[node name="Slots" type="HBoxContainer" parent="HUD/Hud"]
layout_mode = 0
offset_left = 4.0
offset_top = 4.0
offset_right = 132.0
offset_bottom = 24.0
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Messages" type="VBoxContainer" parent="HUD/Hud"]
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -120.0
offset_top = 64.0
offset_right = 120.0
offset_bottom = 100.0
grow_horizontal = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Banner" type="Label" parent="HUD/Hud"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -30.0
offset_right = 150.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_outline_color = Color(0.05, 0.05, 0.08, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 16
text = "STAGE CLEAR"
horizontal_alignment = 1

[node name="BannerSub" type="Label" parent="HUD/Hud"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -6.0
offset_right = 150.0
offset_bottom = 4.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_outline_color = Color(0.05, 0.05, 0.08, 1)
theme_override_constants/outline_size = 4
text = "R: PLAY AGAIN   ESC: MENU"
horizontal_alignment = 1

[node name="Controls" type="Label" parent="HUD/Hud"]
modulate = Color(1, 1, 1, 0.5)
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 4.0
offset_top = -21.0
offset_right = 380.0
offset_bottom = -2.0
grow_vertical = 0
text = "MOVE: A D   JUMP: W   POTION: 1-4 OR CLICK
THROW: DRAG, LET GO   RESTART: R   MENU: ESC"

[node name="CancelZone" type="Panel" parent="HUD/Hud"]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -40.0
offset_top = 4.0
offset_right = -4.0
offset_bottom = 40.0
grow_horizontal = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBox_cancel")

[node name="X" type="Label" parent="HUD/Hud/CancelZone"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(1, 0.75, 0.78, 1)
theme_override_font_sizes/font_size = 16
text = "X"
horizontal_alignment = 1
vertical_alignment = 1
